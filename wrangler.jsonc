{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oceanhud",
  "main": "OceanHub_SECURITY_PATCHED_FINAL_v11.js",
  "compatibility_date": "2026-09-27",

  "vars": {
  "BASE_URL": "https://oceanhud.yoelenmanuelzorrilla.workers.dev",
  "GEMINI_MODEL": "gemini-3.1-flash-lite",
  "OPENROUTER_MODEL": "openrouter/free"
}

  "kv_namespaces" [
    {
      "binding": "STATS",
      "id": "1cf0ffb0625b4852820af0696d71d6c5"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "KV_LOCKER",
        "class_name": "KVLocker"
      }
    ]
  },

  "exports": {
    "KVLocker": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
